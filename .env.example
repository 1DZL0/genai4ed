# Copy to .env. Every value below is a working local default.
# The stack runs, and the whole test suite passes, with no API key set.

# The project's own Postgres container (docker compose up -d), on 5433.
# 127.0.0.1 and not localhost: on Windows, localhost resolves to IPv6 ::1
# first, and Docker Desktop's published port does not answer there - the
# connection just times out. Port 5432 is the machine's own Postgres server.
DATABASE_URL=postgresql+asyncpg://genai4ed:genai4ed@127.0.0.1:5433/genai4ed

# stub | anthropic. The stub is deterministic and offline.
LLM_PROVIDER=stub
# Server-side only. Never exposed to the browser (concept note S4).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Both spellings of loopback: they are different origins to a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sign-in. Teachers use email + password (created with `python -m app.accounts`),
# students a join code their teacher issues. SECRET_KEY keys the join-code
# digests: set a long random value, and changing it invalidates every code.
SECRET_KEY=dev-only-secret-change-me
# Demo: any username and password sign in, creating the account on first use.
DEMO_SIGN_IN=true
SIGN_IN_HOURS=12
# true once the site is only reached over HTTPS end to end.
COOKIE_SECURE=false

# Test-suite shortcut: trusts a pseudonym sent in a header, with no sign-in.
# Leave off. The tests switch it on for themselves.
DEV_IDENTITY_ENABLED=false
DEV_IDENTITY_HEADER=X-GenAI4ED-Pseudonym

# Retention schedule (S4: raw exploratory chat is kept for less time than
# submitted work). Provisional until fixed with the school/DPO.
EXPLORATORY_CHAT_RETENTION_DAYS=7
SUBMITTED_WORK_RETENTION_DAYS=365
